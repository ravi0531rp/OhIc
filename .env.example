# Backend identity and network binding (all optional)
OHIC_APP_NAME=OhIc
OHIC_HOST=127.0.0.1
OHIC_PORT=8000
OHIC_FRONTEND_ORIGIN=http://localhost:3000

# Local files and limits
OHIC_DATA_DIR=../data
OHIC_MODEL_DIR=../data/models
OHIC_MAX_UPLOAD_GB=20
OHIC_STALE_TEMP_HOURS=24
OHIC_CHECKPOINT_SECONDS=30
OHIC_YOUTUBE_COOKIES_FILE=

# Pipeline defaults reserved for compatible model/codec integrations
OHIC_DEFAULT_MODEL=realesrgan-x2plus
OHIC_DEFAULT_CODEC=h264
OHIC_ENABLE_REALBASICVSR=true
# Optional Pro model overrides; leave unset for the platform-tuned defaults.
# OHIC_PRO_QWEN_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit
# OHIC_PRO_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Logging
OHIC_LOG_LEVEL=INFO

# Frontend -> local backend (read at frontend build/start time)
NEXT_PUBLIC_API_URL=http://localhost:8000
